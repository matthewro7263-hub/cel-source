# ---- App ----
NODE_ENV=development
PORT=5000

# ---- Database (Postgres for Drizzle) ----
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/cel_source

# ---- Sessions / Auth ----
# Generate a strong random string (e.g. `openssl rand -hex 32`)
SESSION_SECRET=replace-with-a-long-random-string

# ---- Admin / demo ----
# Comma-separated emails that may create challenge prompts and leaderboard snapshots.
CEL_ADMIN_EMAILS=
# Multiply the built-in rate limits (default 1)
CEL_RATE_LIMIT_SCALE=

# ---- Email (optional; powers password reset, invitations, commission notifications) ----
RESEND_API_KEY=
MAIL_FROM=
APP_URL=
CONTACT_EMAIL=
# Demo accounts (public password) are only seeded outside production unless this is "true".
CEL_SEED_DEMO=
# Optional: enables sound-effect search (https://freesound.org/apiv2/apply/)
FREESOUND_API_KEY=

# ---- Encryption (AI keys at rest) ----
# 64-char hex string (32 bytes). Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-char-hex-string

# ---- Cloudflare R2 (S3-compatible) ----
# Bucket: cel-source-uploads (private)
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_BUCKET=cel-source-uploads
R2_ENDPOINT=https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=REPLACE_WITH_YOUR_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_YOUR_SECRET_ACCESS_KEY

# ---- CORS ----
# Comma-separated allowed frontend origins (code reads CEL_ALLOWED_ORIGINS)
# e.g. CEL_ALLOWED_ORIGINS=https://cel-source.onrender.com,http://localhost:5173
CEL_ALLOWED_ORIGINS=

# Discord webhooks are configured per-project in project settings (not a global env var).
# ---- Optional ----
# neon | pg. Default: Neon's serverless driver for *.neon.tech hosts, node-postgres otherwise.
CEL_DB_DRIVER=
# Override the OpenRouter base URL (tests / OpenAI-compatible proxies).
OPENROUTER_BASE_URL=
