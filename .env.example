# ---- App ----
NODE_ENV=development
PORT=5000

# ---- Database (Postgres for Drizzle) ----
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/cel_source

# ---- Sessions / Auth ----
# Generate a strong random string (e.g. `openssl rand -hex 32`)
SESSION_SECRET=replace-with-a-long-random-string

# ---- Encryption (AI keys at rest) ----
# 64-char hex string (32 bytes). Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-char-hex-string

# ---- Cloudflare R2 (S3-compatible) ----
# Bucket: cel-source-uploads (private)
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_BUCKET=cel-source-uploads
R2_ENDPOINT=https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=REPLACE_WITH_YOUR_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_YOUR_SECRET_ACCESS_KEY

# ---- CORS ----
# Comma-separated allowed frontend origins (code reads CEL_ALLOWED_ORIGINS)
# e.g. CEL_ALLOWED_ORIGINS=https://cel-source.onrender.com,http://localhost:5173
CEL_ALLOWED_ORIGINS=

# Discord webhooks are configured per-project in project settings (not a global env var).